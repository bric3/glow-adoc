# SPDX-License-Identifier: MPL-2.0

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{java,kt,kts}]
max_line_length = 120

[*.{kt,kts}]
ktlint_code_style = intellij_idea

[*.{yml,yaml,rb}]
indent_size = 2

[*.{md,adoc}]
trim_trailing_whitespace = false
